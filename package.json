{
  "name": "baseline",
  "version": "1.0.0",
  "description": "A time-locked focus profile for a supervised iPhone, with a status PWA",
  "scripts": {
    "dev:pwa": "vite --config vite.pwa.config.ts",
    "dev:mac": "vite --config vite.mac.config.ts",
    "build": "vite build --config vite.pwa.config.ts && vite build --config vite.mac.config.ts",
    "server": "node server/index.ts",
    "mac": "node mac/index.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "author": "amarzbar",
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "express": "4.21.2",
    "plist": "3.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tlock-js": "0.9.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/express": "^4.17.25",
    "@types/node": "^24.19.2",
    "@types/plist": "^3.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vite": "^7.3.8"
  },
  "private": true,
  "packageManager": "pnpm@11.28.11"
}
