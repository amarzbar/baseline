{
  "name": "baseline-lock",
  "version": "0.1.0",
  "description": "A time-locked focus profile for a supervised iPhone, with a status PWA",
  "keywords": [
    "ios",
    "iphone",
    "configuration-profile",
    "apple-configurator",
    "tlock",
    "drand",
    "digital-wellbeing",
    "focus"
  ],
  "homepage": "https://github.com/amarzbar/baseline#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amarzbar/baseline.git"
  },
  "bugs": "https://github.com/amarzbar/baseline/issues",
  "author": "amarzbar",
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "baseline": "dist/cli/baseline.js"
  },
  "files": [
    "dist/cli",
    "dist/mac",
    "README.md"
  ],
  "os": [
    "darwin"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev:pwa": "vite --config vite.pwa.config.ts",
    "dev:mac": "vite --config vite.mac.config.ts",
    "build": "vite build --config vite.pwa.config.ts && vite build --config vite.mac.config.ts && pnpm build:cli",
    "server": "node server/index.ts",
    "mac": "node mac/index.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build:cli": "esbuild mac/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/cli/baseline.js --banner:js=\"#!/usr/bin/env node\nimport { createRequire as __cr } from 'node:module'; const require = __cr(import.meta.url);\"",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/express": "^4.17.25",
    "@types/node": "^24.19.2",
    "@types/plist": "^3.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "0.28.2",
    "express": "4.21.2",
    "plist": "3.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "tlock-js": "0.9.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.8"
  },
  "packageManager": "pnpm@11.28.11"
}
